# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# GROQ_API_KEY: Groq API key — meal-vision ensemble fallback (currently DORMANT).
# Vision models qwen/qwen3.6-27b & qwen3.8-27b benchmarked 0/6 on real photos;
# ensemble default is GEMINI_ONLY. reasoning_effort=none is mandatory for Qwen.
GROQ_API_KEY=MY_GROQ_API_KEY
