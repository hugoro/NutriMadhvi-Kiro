# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# GROQ_API_KEY: Groq API key — meal-vision ensemble fallback (currently DORMANT).
# Vision models qwen/qwen3.6-27b & qwen3.8-27b benchmarked 0/6 on real photos;
# ensemble default is GEMINI_ONLY. reasoning_effort=none is mandatory for Qwen.
GROQ_API_KEY=MY_GROQ_API_KEY

# RUNINFRA_API_KEY: RunInfra API key — the real Groq failover in the chat
# router (Groq → RunInfra → Gemini, plan §9/§11). Placeholder here so the
# Secrets plugin always generates BuildConfig.RUNINFRA_API_KEY; the real
# value is seeded on-device via .env / scripts/restore-env.sh, never committed.
RUNINFRA_API_KEY=MY_RUNINFRA_API_KEY

# BITDEER_API_KEY: Bitdeer API key — Qwen3-VL-32B vision provider (Phase 9).
# Primary vision model in BITDEER_THEN_GEMINI ensemble mode; Gemini is the fallback.
# Default ensemble mode is GEMINI_ONLY (this key is not used unless the mode is changed).
# Seeded on-device via .env / scripts/restore-env.sh, never committed.
BITDEER_API_KEY=MY_BITDEER_API_KEY
